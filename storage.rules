rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isValidListingCover() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /game-listings/{ownerId}/{listingId}/cover {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(ownerId) && isValidListingCover();
      allow delete: if isOwner(ownerId);
    }
  }
}
