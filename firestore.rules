rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function hasValidOptionalString(data, field, maxLength) {
      return !data.keys().hasAny([field]) || (data[field] is string && data[field].size() <= maxLength);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/gameSessions/$(sessionId);
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/participationRequests/$(requestId);
    }

    function isSessionOrganizer(sessionId) {
      return isAuthenticated()
        && get(sessionPath(sessionId)).data.organizerId == request.auth.uid;
    }

    match /players/{playerId} {
      function hasValidPlayerShape(data) {
        return data.keys().hasAll(['displayName', 'city'])
          && data.keys().hasOnly(['displayName', 'city', 'district', 'description', 'avatarUrl'])
          && isNonEmptyString(data.displayName, 80)
          && data.city == 'Madrid'
          && hasValidOptionalString(data, 'district', 80)
          && hasValidOptionalString(data, 'description', 320)
          && hasValidOptionalString(data, 'avatarUrl', 500);
      }

      allow get: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.auth.uid == playerId
        && hasValidPlayerShape(request.resource.data);
    }

    match /gameSessions/{sessionId} {
      function hasValidSessionShape(data) {
        return data.keys().hasAll([
            'gameName', 'date', 'time', 'city', 'district', 'capacity',
            'organizerId', 'participantIds', 'pendingRequestIds', 'status'
          ])
          && data.keys().hasOnly([
            'gameName', 'date', 'time', 'city', 'district', 'venue',
            'description', 'capacity', 'organizerId', 'participantIds',
            'pendingRequestIds', 'status'
          ])
          && isNonEmptyString(data.gameName, 120)
          && data.date is string
          && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.time is string
          && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.city == 'Madrid'
          && isNonEmptyString(data.district, 80)
          && hasValidOptionalString(data, 'venue', 80)
          && hasValidOptionalString(data, 'description', 320)
          && data.capacity is int
          && data.capacity >= 2
          && data.organizerId is string
          && data.participantIds is list
          && data.pendingRequestIds is list
          && data.participantIds.size() <= data.capacity
          && data.status in ['scheduled', 'cancelled'];
      }

      function isRequestAppend() {
        let expectedRequestId = sessionId + '_' + request.auth.uid;
        let pendingRequest = getAfter(requestPath(expectedRequestId)).data;
        return resource.data.status == 'scheduled'
          && request.resource.data.status == resource.data.status
          && resource.data.participantIds.size() < resource.data.capacity
          && !resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequestIds'])
          && request.resource.data.pendingRequestIds.size() == resource.data.pendingRequestIds.size() + 1
          && request.resource.data.pendingRequestIds.hasAll(resource.data.pendingRequestIds)
          && request.resource.data.pendingRequestIds.hasAny([expectedRequestId])
          && pendingRequest.sessionId == sessionId
          && pendingRequest.playerId == request.auth.uid
          && pendingRequest.status == 'pending';
      }

      function isOrganizerEdit() {
        return resource.data.organizerId == request.auth.uid
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'scheduled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'gameName', 'date', 'time', 'district', 'venue', 'description', 'capacity'
          ])
          && request.resource.data.capacity >= resource.data.participantIds.size();
      }

      function isOrganizerAcceptance() {
        let addedPlayerId = request.resource.data.participantIds[resource.data.participantIds.size()];
        let acceptedRequestId = sessionId + '_' + addedPlayerId;
        let previousRequest = get(requestPath(acceptedRequestId)).data;
        let acceptedRequest = getAfter(requestPath(acceptedRequestId)).data;
        return resource.data.organizerId == request.auth.uid
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'scheduled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'pendingRequestIds'])
          && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
          && request.resource.data.participantIds.hasAll(resource.data.participantIds)
          && !resource.data.participantIds.hasAny([addedPlayerId])
          && resource.data.pendingRequestIds.hasAny([acceptedRequestId])
          && !request.resource.data.pendingRequestIds.hasAny([acceptedRequestId])
          && previousRequest.status == 'pending'
          && acceptedRequest.status == 'confirmed'
          && acceptedRequest.playerId == addedPlayerId
          && acceptedRequest.sessionId == sessionId
          && (
            (request.resource.data.participantIds.size() == request.resource.data.capacity
              && request.resource.data.pendingRequestIds.size() == 0)
            || (request.resource.data.participantIds.size() < request.resource.data.capacity
              && request.resource.data.pendingRequestIds.size() + 1 == resource.data.pendingRequestIds.size()
              && resource.data.pendingRequestIds.hasAll(request.resource.data.pendingRequestIds))
          );
      }

      function isOrganizerRequestRejection() {
        let removedRequestIds = resource.data.pendingRequestIds.removeAll(
          request.resource.data.pendingRequestIds
        );
        let removedRequest = getAfter(requestPath(removedRequestIds[0])).data;
        return resource.data.organizerId == request.auth.uid
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'scheduled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequestIds'])
          && request.resource.data.pendingRequestIds.size() + 1 == resource.data.pendingRequestIds.size()
          && resource.data.pendingRequestIds.hasAll(request.resource.data.pendingRequestIds)
          && removedRequestIds.size() == 1
          && removedRequest.sessionId == sessionId
          && removedRequest.status == 'rejected';
      }

      function isOrganizerCancellation() {
        return resource.data.organizerId == request.auth.uid
          && resource.data.status == 'scheduled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.pendingRequestIds.size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pendingRequestIds']);
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && hasValidSessionShape(request.resource.data)
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.participantIds.size() == 1
        && request.resource.data.participantIds[0] == request.auth.uid
        && request.resource.data.pendingRequestIds.size() == 0;
      allow update: if isAuthenticated()
        && hasValidSessionShape(request.resource.data)
        && request.resource.data.organizerId == resource.data.organizerId
        && (
          isRequestAppend()
          || isOrganizerEdit()
          || isOrganizerAcceptance()
          || isOrganizerRequestRejection()
          || isOrganizerCancellation()
        );
    }

    match /participationRequests/{requestId} {
      function hasValidRequestShape(data) {
        return data.keys().hasAll(['sessionId', 'playerId', 'status', 'createdAt'])
          && data.keys().hasOnly(['sessionId', 'playerId', 'status', 'createdAt'])
          && data.sessionId is string
          && data.playerId is string
          && data.status in ['pending', 'confirmed', 'rejected']
          && data.createdAt is timestamp;
      }

      function isValidRequestCreation() {
        let session = get(sessionPath(request.resource.data.sessionId)).data;
        let sessionAfter = getAfter(sessionPath(request.resource.data.sessionId)).data;
        return requestId == request.resource.data.sessionId + '_' + request.auth.uid
          && request.resource.data.playerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && session.status == 'scheduled'
          && session.participantIds.size() < session.capacity
          && !session.participantIds.hasAny([request.auth.uid])
          && sessionAfter.pendingRequestIds.hasAny([requestId]);
      }

      function isOrganizerResolution() {
        let session = get(sessionPath(resource.data.sessionId)).data;
        let sessionAfter = getAfter(sessionPath(resource.data.sessionId)).data;
        return session.organizerId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['confirmed', 'rejected']
          && !sessionAfter.pendingRequestIds.hasAny([requestId])
          && (
            (request.resource.data.status == 'confirmed'
              && session.status == 'scheduled'
              && sessionAfter.status == 'scheduled'
              && !session.participantIds.hasAny([resource.data.playerId])
              && sessionAfter.participantIds.hasAny([resource.data.playerId])
              && sessionAfter.participantIds.size() == session.participantIds.size() + 1
              && sessionAfter.participantIds.size() <= sessionAfter.capacity)
            || (request.resource.data.status == 'rejected'
              && !sessionAfter.participantIds.hasAny([resource.data.playerId]))
          );
      }

      allow get: if isAuthenticated()
        && (!exists(requestPath(requestId))
          || resource.data.playerId == request.auth.uid
          || isSessionOrganizer(resource.data.sessionId));
      allow list: if isAuthenticated()
        && (resource.data.playerId == request.auth.uid
          || isSessionOrganizer(resource.data.sessionId));
      allow create: if isAuthenticated()
        && hasValidRequestShape(request.resource.data)
        && request.resource.data.createdAt == request.time
        && isValidRequestCreation();
      allow update: if isAuthenticated()
        && hasValidRequestShape(request.resource.data)
        && isOrganizerResolution();
    }

    match /gameListings/{listingId} {
      function listingShape(data) {
        return data.keys().hasAll(['ownerId', 'gameName', 'imageUrl', 'description', 'condition', 'listingType', 'city', 'district', 'status', 'createdAt'])
          && data.keys().hasOnly(['ownerId', 'gameName', 'imageUrl', 'description', 'condition', 'listingType', 'priceInCents', 'city', 'district', 'status', 'createdAt'])
          && data.ownerId is string
          && isNonEmptyString(data.gameName, 120)
          && isNonEmptyString(data.imageUrl, 1500)
          && isNonEmptyString(data.description, 500)
          && data.condition in ['new', 'likeNew', 'good', 'used']
          && data.city == 'Madrid'
          && isNonEmptyString(data.district, 80)
          && data.status in ['active', 'closed']
          && data.createdAt is timestamp
          && ((data.listingType == 'sale' && data.priceInCents is int && data.priceInCents > 0)
            || (data.listingType == 'trade' && !data.keys().hasAny(['priceInCents'])));
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.status == 'active'
        && listingShape(request.resource.data);
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == 'active'
        && request.resource.data.status in ['active', 'closed']
        && listingShape(request.resource.data);

      match /interests/{playerId} {
        function interestShape(data) {
          return data.keys().hasOnly(['playerId', 'status', 'createdAt'])
            && data.playerId == playerId
            && data.status in ['pending', 'accepted', 'declined']
            && data.createdAt is timestamp;
        }

        allow get, list: if isAuthenticated()
          && (request.auth.uid == playerId || request.auth.uid == get(/databases/$(database)/documents/gameListings/$(listingId)).data.ownerId);
        allow create: if isAuthenticated()
          && request.auth.uid == playerId
          && get(/databases/$(database)/documents/gameListings/$(listingId)).data.status == 'active'
          && get(/databases/$(database)/documents/gameListings/$(listingId)).data.ownerId != playerId
          && request.resource.data.status == 'pending'
          && interestShape(request.resource.data);
        allow update: if isAuthenticated()
          && request.auth.uid == get(/databases/$(database)/documents/gameListings/$(listingId)).data.ownerId
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined']
          && interestShape(request.resource.data);
      }

      match /contactHandoffs/{playerId} {
        allow get: if isAuthenticated()
          && (request.auth.uid == playerId || request.auth.uid == resource.data.sharedByOwnerId);
        allow create, update: if isAuthenticated()
          && request.auth.uid == get(/databases/$(database)/documents/gameListings/$(listingId)).data.ownerId
          && request.resource.data.interestedPlayerId == playerId
          && request.resource.data.sharedByOwnerId == request.auth.uid
          && request.resource.data.method in ['email', 'phone', 'other']
          && isNonEmptyString(request.resource.data.value, 200)
          && get(/databases/$(database)/documents/gameListings/$(listingId)/interests/$(playerId)).data.status == 'accepted';
      }
    }
  }
}
