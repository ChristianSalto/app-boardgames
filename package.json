{
  "name": "mesa-abierta-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "build": "tsc -b && vite build",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:game-listings": "node --experimental-strip-types --test tests/game-listings.domain.test.ts tests/game-listings.application.test.ts",
    "test:game-sessions": "node scripts/run-game-session-tests.mjs",
    "test:player-trust": "node scripts/run-player-trust-tests.mjs",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "seed:listings": "node scripts/seed-game-listings.mjs",
    "seed:review-session": "node --experimental-strip-types scripts/seed-review-session.mjs",
    "migrate:session-starts-at": "node --experimental-strip-types scripts/migrate-session-starts-at.mjs",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "deploy:hosting:dev": "firebase deploy --only hosting --project mesa-abierta-dev"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.0",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
